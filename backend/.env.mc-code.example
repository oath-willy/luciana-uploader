MC_CODE_LOCAL_DATA_DIR=/home/data/codex
MC_CODE_RUNTIME_DB=/home/data/codex/runtime.sqlite3
MC_CODE_SNAPSHOT_TOKEN=generate-a-long-random-secret
BS25AI_WORKER_URL=http://10.0.0.5:8094
BS25AI_WORKER_TOKEN=use-the-same-secret-configured-on-lucianavm04
BS25AI_WORKER_TIMEOUT_SECONDS=900
# Usare solo quando lucianavm04 non e disponibile. Nessuna chiamata remota viene eseguita.
BS25AI_MOCK_MODE=false

# BS25 deterministico eseguito su lucianavm04 (rete privata Azure).
BS25_WORKER_URL=http://10.0.0.5:8094
BS25_WORKER_TOKEN=use-the-same-secret-configured-on-lucianavm04
BS25_WORKER_TIMEOUT_SECONDS=180

# Aggiornamento del Reference PDB da Database > PDB > Settings.
PDB_REF_VM_HOST=10.0.0.5
PDB_REF_VM_USERNAME=lucianauser
PDB_REF_LOCAL_PATH=/home/data/codex/ref_pdb_dump.parquet
PDB_REF_STATUS_DB=/home/data/codex/pdb-settings.sqlite3
PDB_REF_FETCH_TIMEOUT_SECONDS=3600
PDB_REF_INDEX_TIMEOUT_SECONDS=7200
