MC_CODE_LOCAL_DATA_DIR=/home/data/codex
PDB_NEW_ITEMS_RUNTIME_DB=/home/data/codex/runtime_pdb_new_items.sqlite3
MC_CODE_SNAPSHOT_TOKEN=generate-a-long-random-secret
BS25AI_WORKER_URL=http://10.0.0.5:8094
BS25AI_WORKER_TOKEN=use-the-same-secret-configured-on-lucianavm04
BS25AI_WORKER_TIMEOUT_SECONDS=900
# Usare solo quando lucianavm04 non e disponibile. Nessuna chiamata remota viene eseguita.
BS25AI_MOCK_MODE=false

# BS25 deterministico eseguito su lucianavm04 (rete privata Azure).
BS25_WORKER_URL=http://10.0.0.5:8094
BS25_WORKER_TOKEN=use-the-same-secret-configured-on-lucianavm04
BS25_WORKER_TIMEOUT_SECONDS=180

# Aggiornamento del Reference PDB da Database > PDB > Settings.
PDB_REF_VM_HOST=10.0.0.5
PDB_REF_VM_USERNAME=lucianauser
PDB_REF_LOCAL_PATH=/home/data/codex/ref_pdb_dump.parquet
PDB_REF_STATUS_DB=/home/data/codex/pdb-settings.sqlite3
PDB_REF_FETCH_TIMEOUT_SECONDS=3600
PDB_REF_INDEX_TIMEOUT_SECONDS=7200

# Copia MC Classification da stkeystoneresearchdev al backend e a lucianavm04.
PDB_MC_CLASSIFICATION_LOCAL_PATH=/home/data/codex/pdb_mc_classification.parquet
PDB_MC_CLASSIFICATION_RUNTIME_DB=/home/data/codex/runtime_pdb_mc_classification.sqlite3
PDB_MC_CLASSIFICATION_STATUS_DB=/home/data/codex/pdb-mc-classification-sync.sqlite3
PDB_MC_CLASSIFICATION_REMOTE_PATH=/home/lucianauser/panel_data_utilities/scripts/jobs/pdb/pdb_mc_classification.parquet
# Opzionali: in assenza vengono riusati i valori PDB_NEW_ITEMS_* o la Managed Identity.
# PDB_MC_CLASSIFICATION_STORAGE_CONNECTION_STRING=
# PDB_MC_CLASSIFICATION_STORAGE_SECRET=
PDB_MC_CLASSIFICATION_VM_TIMEOUT_SECONDS=3600

# Copia Brands Dictionary da stkeystoneresearchdev al backend.
PDB_BRANDS_DICTIONARY_LOCAL_PATH=/home/data/codex/pdb_brands_dictionary.parquet
PDB_BRANDS_DICTIONARY_WORKSPACE_DB=/home/data/codex/pdb_brands_dictionary_workspace.sqlite3
PDB_BRANDS_DICTIONARY_STATUS_DB=/home/data/codex/pdb-brands-dictionary-sync.sqlite3
# Opzionali: in assenza vengono riusati i valori PDB_NEW_ITEMS_* o la Managed Identity.
# PDB_BRANDS_DICTIONARY_STORAGE_CONNECTION_STRING=
# PDB_BRANDS_DICTIONARY_STORAGE_SECRET=

# Fast Track: modulo separato; il cambio di utente non richiede modifiche al codice.
FAST_TRACK_ENABLED=true
FAST_TRACK_SOURCE_USER=wilson_sgroi
# Se omesso: /home/<FAST_TRACK_SOURCE_USER>/dtl_fast-track
# FAST_TRACK_SOURCE_ROOT=/home/wilson_sgroi/dtl_fast-track
FAST_TRACK_LOCAL_DIR=/home/data/fast-track
FAST_TRACK_RSCRIPT=/opt/R/4.5.2/bin/Rscript
FAST_TRACK_JOB_TIMEOUT_SECONDS=3600
FAST_TRACK_FILE_TIMEOUT_SECONDS=180
# Opzionale: pin alternativo verificato dall'IT. Il default usa le chiavi note di lucianavm04.
# FAST_TRACK_SSH_HOST_KEY_SHA256=SHA256:<fingerprint>
# In Azure abilitare solo dopo aver collegato SWA e App Service con Easy Auth obbligatorio.
# In locale e consentito automaticamente solo da localhost.
FAST_TRACK_AUTH_MODE=linked
