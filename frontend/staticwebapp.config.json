{
  "routes": [
    {
      "route": "/api/*",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/login",
      "rewrite": "/index.html",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/auth-debug",
      "rewrite": "/index.html",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/static/*",
      "allowedRoles": [
        "anonymous",
        "authenticated"
      ]
    },
    {
      "route": "/manifest.json",
      "allowedRoles": [
        "anonymous",
        "authenticated"
      ]
    },
    {
      "route": "/favicon.ico",
      "allowedRoles": [
        "anonymous",
        "authenticated"
      ]
    },
    {
      "route": "/",
      "rewrite": "/index.html",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/*",
      "rewrite": "/index.html",
      "allowedRoles": [
        "authenticated"
      ]
    }
  ],
  "networking": {
    "allowedIpRanges": [
      "151.14.55.196/32",
      "20.160.158.80/32"
    ]
  },
  "auth": {
    "identityProviders": {
      "azureActiveDirectory": {
        "userDetailsClaim": "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress",
        "registration": {
          "openIdIssuer": "https://login.microsoftonline.com/3630ff06-11ea-4763-960a-fc74e8780220/v2.0",
          "clientIdSettingName": "LUCIANA_AAD_CLIENT_ID",
          "clientSecretSettingName": "LUCIANA_AAD_CLIENT_SECRET"
        }
      }
    }
  },
  "responseOverrides": {
    "401": {
      "redirect": "/login",
      "statusCode": 302
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Frame-Options": "SAMEORIGIN"
  }
}
